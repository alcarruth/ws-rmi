#!/bin/bash
#
# file: /bin/pkg_info
#
# source this file like this:
# source $(dirname $(realpath ${0}))/pkg_info
#

pkg_bin=$(dirname $(realpath ${0}))
pkg_root=$(realpath ${pkg_bin}/..)
pkg_name=$(basename ${pkg_root})
pkg_src=${pkg_root}/src

pushd $pkg_root &> /dev/null
pkg_branch="$(git rev-parse --abbrev-ref HEAD)"
popd &> /dev/null

function pkg_info_json() {
  echo "{"
  echo "  \"pkg_root\": \"${pkg_root}\","
  echo "  \"pkg_bin\": \"${pkg_bin}\","
  echo "  \"pkg_src\": \"${pkg_src}\","
  echo "  \"pkg_name\": \"${pkg_name}\","
  echo "  \"pkg_branch\": \"${pkg_branch}\""
  echo "}"
}

function build_root_index {
  echo "building ${pkg_name}/index.js"
  echo "#!/usr/bin/env coffee
//
// file: /index.js
// package: ${pkg_name}
//

(function() {
  module.exports = require('./${pkg_branch}');
}).call(this);
" >${pkg_root}/index.js
}
